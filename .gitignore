# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地配置与凭据（面板配置默认存放在 /etc/serverpanel 或 ~/.config/serverpanel，不在此目录）
config.json
.env
*.log

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 运行时产物（部署时机与仓库同目录：守护脚本 / pid / 锁 / 轮转日志）
panel-supervisor.sh
.supervisor.pid
.supervisor.lock
*.log.1

# 升级锁文件（flock 持有期间保留，进程退出后遗留也不该挡住下次升级）
update.lock
